    /* MODULE 1 LOGIC: REVISION & EXPLORER */
    function filterRevisionList() {
      renderRevisionList();
    }

    function renderRevisionList() {
      const query = document.getElementById('search-input').value.toLowerCase().trim();
      const filter = document.getElementById('filter-type').value;
      const container = document.getElementById('revision-list-view');

      container.innerHTML = '';

      const filtered = vocabData.filter(v => {
        const matchesQuery = v.word.toLowerCase().includes(query) || 
                             v.meaning.toLowerCase().includes(query) || 
                             v.cantonese.includes(query);
        
        const isMastered = !!userMastery[v.id];
        const isStarred = !!userStarred[v.id];

        if(filter === 'mastered' && !isMastered) return false;
        if(filter === 'unmastered' && isMastered) return false;
        if(filter === 'starred' && !isStarred) return false;

        return matchesQuery;
      });

      if(filtered.length === 0) {
        container.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 font-medium">No matching vocabulary terms found.</div>`;
        return;
      }

      filtered.forEach(v => {
        const isMastered = !!userMastery[v.id];
        const isStarred = !!userStarred[v.id];

        const card = document.createElement('div');
        card.className = `bg-white p-5 rounded-2xl shadow-sm border transition flex flex-col justify-between space-y-4 ${isMastered ? 'border-emerald-300 bg-emerald-50/20' : 'border-slate-200'}`;
        card.innerHTML = `
          <div class="space-y-2">
            <div class="flex items-start justify-between">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-bold text-slate-900">${v.word}</h3>
                  <button onclick="speakWord('${v.word}')" class="text-cambridge-600 hover:text-cambridge-800 text-xs">
                    <i class="fa-solid fa-volume-high"></i>
                  </button>
                </div>
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-slate-100 text-slate-600 rounded mt-1">${v.pos}</span>
              </div>
              <button onclick="toggleStar(${v.id})" class="text-base ${isStarred ? 'text-amber-500' : 'text-slate-300 hover:text-amber-400'}">
                <i class="fa-solid fa-star"></i>
              </button>
            </div>

            <!-- Cantonese Translation Highlight -->
            <div class="bg-cantonese-50/80 p-2.5 rounded-xl border border-cantonese-100">
              <span class="text-[10px] font-bold text-cantonese-700 uppercase tracking-wide block">粵語 廣東話翻譯</span>
              <p class="text-base font-bold text-slate-900">${v.cantonese}</p>
            </div>

            <!-- Cambridge Meaning -->
            <div>
              <span class="text-[10px] font-bold text-cambridge-700 uppercase tracking-wide block">Cambridge English Meaning</span>
              <p class="text-xs text-slate-700 leading-relaxed">${v.meaning}</p>
            </div>
          </div>

          <!-- Sentence & Toggle Mastered Button -->
          <div class="pt-3 border-t border-slate-100 space-y-2">
            <p class="text-[11px] text-slate-500 italic bg-slate-50 p-2 rounded border border-slate-100">"${v.sentence}"</p>
            
            <button onclick="toggleMastery(${v.id})" class="w-full py-2 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 ${isMastered ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}">
              <i class="fa-solid ${isMastered ? 'fa-check-circle text-emerald-600' : 'fa-circle text-slate-300'}"></i>
              ${isMastered ? 'Mastered' : 'Mark as Mastered'}
            </button>
          </div>
        `;
        container.appendChild(card);
      });
