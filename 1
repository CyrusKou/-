    function toggleMastery(id) {
      userMastery[id] = !userMastery[id];
      saveState();
      renderRevisionList();
    }

    function toggleStar(id) {
      userStarred[id] = !userStarred[id];
      saveState();
      renderRevisionList();
    }

    function toggleCardViewMode() {
      isFcView = !isFcView;
      const listView = document.getElementById('revision-list-view');
      const fcView = document.getElementById('revision-flashcard-view');
      const label = document.getElementById('view-mode-label');

      if(isFcView) {
        listView.classList.add('hidden');
        fcView.classList.remove('hidden');
        label.innerText = "Switch to Grid View";
        loadFlashcard();
      } else {
        listView.classList.remove('hidden');
        fcView.classList.add('hidden');
        label.innerText = "Switch to Flashcard Mode";
      }
    }

    function loadFlashcard() {
      const v = vocabData[currentFcIndex];
      currentFcWord = v.word;

      document.getElementById('flashcard-counter').innerText = `Card ${currentFcIndex + 1} / ${vocabData.length}`;
      document.getElementById('fc-pos').innerText = v.pos;
      document.getElementById('fc-word').innerText = v.word;
      document.getElementById('fc-cantonese').innerText = v.cantonese;
      document.getElementById('fc-meaning').innerText = v.meaning;
      document.getElementById('fc-sentence').innerText = v.sentence;

      document.getElementById('flashcard-element').classList.remove('flipped');
    }

    function toggleFlashcardFlip() {
      document.getElementById('flashcard-element').classList.toggle('flipped');
    }

    function prevFlashcard() {
      if(currentFcIndex > 0) currentFcIndex--;
      else currentFcIndex = vocabData.length - 1;
      loadFlashcard();
    }

    function nextFlashcard() {
      if(currentFcIndex < vocabData.length - 1) currentFcIndex++;
      else currentFcIndex = 0;
      loadFlashcard();
    }

    function markCurrentFc(isMastered) {
      const v = vocabData[currentFcIndex];
      userMastery[v.id] = isMastered;
      saveState();
      nextFlashcard();
    }

    function speakWord(text) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const msg = new SpeechSynthesisUtterance(text);
        msg.lang = 'en-US';
        msg.rate = 0.9;
        window.speechSynthesis.speak(msg);
      }
    }

