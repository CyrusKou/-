<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Robot Revolution Vocabulary Revision Suite</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            cambridge: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#0284c7',
              600: '#0369a1',
              700: '#075985',
              800: '#0c4a6e',
              900: '#0f172a',
            },
            cantonese: {
              50: '#fdf2f8',
              100: '#fce7f3',
              500: '#ec4899',
              600: '#db2777',
              700: '#be185d',
            }
          }
        }
      }
    }
  </script>
  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    
    .active-tab {
      background-color: #0c4a6e !important;
      color: #ffffff !important;
      box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.2);
    }

    .flip-card {
      perspective: 1000px;
    }
    .flip-card-inner {
      transition: transform 0.6s;
      transform-style: preserve-3d;
    }
    .flip-card.flipped .flip-card-inner {
      transform: rotateY(180deg);
    }
    .flip-card-front, .flip-card-back {
      backface-visibility: hidden;
    }
    .flip-card-back {
      transform: rotateY(180deg);
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased flex flex-col min-h-screen">

  <!-- Top Navigation Header -->
  <header class="bg-cambridge-800 text-white shadow-lg sticky top-0 z-50 border-b border-cambridge-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center space-x-3">
          <div class="bg-amber-400 text-slate-900 font-extrabold p-2 rounded-xl text-xl flex items-center justify-center w-10 h-10 shadow-md">
            <i class="fa-solid fa-robot"></i>
          </div>
          <div>
            <h1 class="font-extrabold text-base sm:text-lg leading-tight tracking-tight">Robot Revolution Vocab Lab</h1>
            <p class="text-xs text-cambridge-100 flex items-center gap-1.5 font-medium">
              <span>Cambridge Dictionary + Context</span>
              <span class="text-amber-300">• 65 Terms</span>
              <span class="bg-cantonese-600 text-white text-[10px] px-1.5 py-0.2 rounded font-bold">粵語 廣東話</span>
            </p>
          </div>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden lg:flex items-center space-x-1.5">
          <button onclick="switchTab('revision')" id="tab-btn-revision" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-cambridge-100 hover:bg-cambridge-700 transition flex items-center gap-2 active-tab">
            <i class="fa-solid fa-book-open"></i> 1. Meaning & Cantonese
          </button>
          <button onclick="switchTab('matching')" id="tab-btn-matching" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-cambridge-100 hover:bg-cambridge-700 transition flex items-center gap-2">
            <i class="fa-solid fa-puzzle-piece"></i> 2. Matching Game
          </button>
          <button onclick="switchTab('mcq')" id="tab-btn-mcq" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-cambridge-100 hover:bg-cambridge-700 transition flex items-center gap-2">
            <i class="fa-solid fa-list-check"></i> 3. Multiple Choice
          </button>
          <button onclick="switchTab('cloze')" id="tab-btn-cloze" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-semibold text-cambridge-100 hover:bg-cambridge-700 transition flex items-center gap-2">
            <i class="fa-solid fa-pen-to-square"></i> 4. Fill in Blanks
          </button>
        </div>

        <!-- Quick Stats -->
        <div class="flex items-center space-x-2 text-xs bg-cambridge-900/60 py-1.5 px-3 rounded-full border border-cambridge-600">
          <span class="text-emerald-400 font-bold" id="stat-mastered"><i class="fa-solid fa-circle-check"></i> 0</span>
          <span class="text-slate-400">/</span>
          <span class="text-slate-300 font-bold">65 Mastered</span>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation Tab Bar -->
    <div class="lg:hidden flex overflow-x-auto bg-cambridge-900 border-t border-cambridge-700 px-2 py-1.5 text-xs space-x-1">
      <button onclick="switchTab('revision')" id="mob-btn-revision" class="mob-tab-btn px-3 py-1.5 rounded whitespace-nowrap bg-cambridge-700 text-white font-semibold">1. Revision</button>
      <button onclick="switchTab('matching')" id="mob-btn-matching" class="mob-tab-btn px-3 py-1.5 rounded whitespace-nowrap text-cambridge-100 font-medium">2. Matching</button>
      <button onclick="switchTab('mcq')" id="mob-btn-mcq" class="mob-tab-btn px-3 py-1.5 rounded whitespace-nowrap text-cambridge-100 font-medium">3. MC Quiz</button>
      <button onclick="switchTab('cloze')" id="mob-btn-cloze" class="mob-tab-btn px-3 py-1.5 rounded whitespace-nowrap text-cambridge-100 font-medium">4. Cloze</button>
    </div>
  </header>

  <main class="flex-grow max-w-7xl w-full mx-auto p-4 sm:p-6 space-y-6">

    <!-- MODULE 1: MEANING & CANTONESE TRANSLATION REVISION -->
    <section id="module-revision" class="tab-content space-y-6">
      
      <!-- Search and Filter Panel -->
      <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <div class="relative flex-grow max-w-lg">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="search-input" oninput="filterRevisionList()" placeholder="Search word, Cambridge meaning, or Cantonese (廣東話)..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-cambridge-500 text-sm">
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <select id="filter-type" onchange="filterRevisionList()" class="bg-slate-50 border border-slate-300 text-slate-700 text-xs sm:text-sm rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-cambridge-500">
            <option value="all">All Words (65)</option>
            <option value="mastered">Mastered Only</option>
            <option value="unmastered">Needs Review</option>
            <option value="starred">Starred ⭐</option>
          </select>

          <button onclick="toggleCardViewMode()" id="toggle-view-btn" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm px-3.5 py-2 rounded-xl font-semibold border border-slate-300 transition flex items-center gap-1.5">
            <i class="fa-solid fa-address-card text-cambridge-600"></i> <span id="view-mode-label">Switch to Flashcard Mode</span>
          </button>
        </div>
      </div>

      <!-- List View vs Flashcard View Container -->
      <div id="revision-list-view" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Vocabulary Cards will be inserted here dynamically -->
      </div>

      <!-- Flashcard Interactive View (Hidden by default) -->
      <div id="revision-flashcard-view" class="hidden max-w-2xl mx-auto space-y-6">
        <div class="flex items-center justify-between bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
          <span class="text-xs font-bold uppercase text-cambridge-600 tracking-wider" id="flashcard-counter">Card 1 / 65</span>
          <div class="flex items-center space-x-2">
            <button onclick="prevFlashcard()" class="p-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold transition"><i class="fa-solid fa-arrow-left"></i> Prev</button>
            <button onclick="nextFlashcard()" class="p-2 bg-cambridge-600 hover:bg-cambridge-700 text-white rounded-lg text-xs font-bold transition">Next <i class="fa-solid fa-arrow-right"></i></button>
          </div>
        </div>

        <!-- Flip Card -->
        <div id="flashcard-element" class="flip-card h-80 w-full cursor-pointer" onclick="toggleFlashcardFlip()">
          <div class="flip-card-inner relative w-full h-full rounded-2xl shadow-lg border border-slate-200 bg-white p-8 flex flex-col justify-between">
            
            <!-- Front -->
            <div class="flip-card-front absolute inset-0 p-8 flex flex-col justify-between bg-gradient-to-br from-white to-cambridge-50 rounded-2xl">
              <div class="flex justify-between items-center">
                <span class="text-xs font-bold px-2.5 py-1 bg-cambridge-100 text-cambridge-800 rounded-md uppercase" id="fc-pos">POS</span>
                <span class="text-xs text-slate-400"><i class="fa-solid fa-rotate mr-1"></i> Tap to reveal Cantonese & Meaning</span>
              </div>
              <div class="text-center my-auto">
                <h3 class="text-4xl font-extrabold text-slate-900 mb-2" id="fc-word">Word</h3>
                <button onclick="event.stopPropagation(); speakWord(currentFcWord)" class="text-xs bg-cambridge-600 hover:bg-cambridge-700 text-white px-3 py-1 rounded-full shadow transition inline-flex items-center gap-1">
                  <i class="fa-solid fa-volume-high"></i> Pronounce
                </button>
              </div>
              <div class="text-center text-xs text-slate-400 italic">
                From National Geographic: "The Robot Revolution Has Arrived"
              </div>
            </div>

            <!-- Back -->
            <div class="flip-card-back absolute inset-0 p-6 flex flex-col justify-between bg-cambridge-900 text-white rounded-2xl">
              <div class="flex justify-between items-center text-xs">
                <span class="bg-amber-400 text-slate-900 font-extrabold px-2.5 py-0.5 rounded" id="fc-cantonese-badge">廣東話</span>
                <span>Click to flip back</span>
              </div>
              <div class="my-auto space-y-3">
                <div>
                  <span class="text-[11px] font-bold uppercase text-amber-300 block mb-0.5">Cantonese Translation (粵語)</span>
                  <p class="text-xl font-bold text-white" id="fc-cantonese">廣東話翻譯</p>
                </div>
                <div>
                  <span class="text-[11px] font-bold uppercase text-cambridge-100 block mb-0.5">Cambridge English Meaning</span>
                  <p class="text-sm text-slate-200 leading-relaxed" id="fc-meaning">Definition here...</p>
                </div>
                <div class="bg-cambridge-800/80 p-2.5 rounded-lg border border-cambridge-700 text-xs italic text-slate-300">
                  "<span id="fc-sentence">Context sentence...</span>"
                </div>
              </div>
            </div>

          </div>
        </div>

        <div class="flex justify-center space-x-3">
          <button onclick="markCurrentFc(false)" class="flex-1 bg-red-50 hover:bg-red-100 text-red-700 font-bold py-3 rounded-xl border border-red-200 text-xs transition">
            <i class="fa-solid fa-xmark mr-1"></i> Need More Practice
          </button>
          <button onclick="markCurrentFc(true)" class="flex-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold py-3 rounded-xl border border-emerald-200 text-xs transition">
            <i class="fa-solid fa-check mr-1"></i> Mastered!
          </button>
        </div>
      </div>

    </section>

    <!-- MODULE 2: MATCHING GAME -->
    <section id="module-matching" class="tab-content hidden space-y-6">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4">
          <div>
            <span class="px-2.5 py-1 bg-cantonese-100 text-cantonese-700 font-bold text-xs rounded-full uppercase tracking-wide">Interactive Practice</span>
            <h2 class="text-2xl font-bold text-slate-900 mt-1">Vocabulary Matching Challenge</h2>
            <p class="text-xs text-slate-500">Match the English target word on the left with its correct Cambridge meaning & Cantonese translation on the right.</p>
          </div>
          <div class="flex items-center space-x-3">
            <div class="bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-700">
              Score: <span id="match-score" class="text-cambridge-600 font-black text-sm">0</span>
            </div>
            <button onclick="initMatchingGame()" class="bg-cambridge-600 hover:bg-cambridge-700 text-white text-xs font-bold px-4 py-2 rounded-xl shadow transition flex items-center gap-1.5">
              <i class="fa-solid fa-arrows-rotate"></i> Reset / New Batch
            </button>
          </div>
        </div>

        <div id="match-game-board" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Words column -->
          <div class="space-y-3" id="match-col-words"></div>
          <!-- Definitions column -->
          <div class="space-y-3" id="match-col-defs"></div>
        </div>

        <div id="match-completion-msg" class="hidden bg-emerald-50 border border-emerald-300 p-4 rounded-xl text-center text-emerald-800 font-bold text-sm">
          🎉 Awesome! You matched all items in this batch! Click "Reset / New Batch" to continue practicing remaining words.
        </div>
      </div>
    </section>

    <!-- MODULE 3: MULTIPLE CHOICE QUIZ -->
    <section id="module-mcq" class="tab-content hidden space-y-6">
      <div class="max-w-3xl mx-auto bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-200 pb-4">
          <div>
            <span class="px-2.5 py-1 bg-amber-100 text-amber-800 font-bold text-xs rounded-full uppercase tracking-wide">Standardized Test Mode</span>
            <h2 class="text-2xl font-bold text-slate-900 mt-1">Multiple Choice Assessment</h2>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-500 block">Question</span>
            <span class="text-lg font-black text-cambridge-600" id="mcq-progress">1 / 65</span>
          </div>
        </div>

        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-3">
          <span class="text-xs font-extrabold text-cambridge-600 uppercase tracking-wide">Question Prompt:</span>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug" id="mcq-question-text">Loading question...</h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="mcq-options-container">
          <!-- Dynamic options -->
        </div>

        <div id="mcq-feedback" class="hidden p-4 rounded-xl text-sm font-semibold"></div>

        <div class="flex justify-between items-center pt-4 border-t border-slate-100">
          <span class="text-xs text-slate-500 font-semibold">Score: <span id="mcq-score-display" class="text-emerald-600 font-bold">0</span></span>
          <button onclick="nextMcqQuestion()" id="mcq-next-btn" class="bg-cambridge-600 hover:bg-cambridge-700 text-white font-bold px-6 py-2.5 rounded-xl shadow transition text-xs flex items-center gap-2">
            Next Question <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- MODULE 4: FILL IN THE BLANKS (CLOZE) -->
    <section id="module-cloze" class="tab-content hidden space-y-6">
      <div class="max-w-3xl mx-auto bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-slate-200 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-200 pb-4">
          <div>
            <span class="px-2.5 py-1 bg-indigo-100 text-indigo-800 font-bold text-xs rounded-full uppercase tracking-wide">Contextual Passage Exercise</span>
            <h2 class="text-2xl font-bold text-slate-900 mt-1">Fill in the Blanks (Cloze)</h2>
            <p class="text-xs text-slate-500">Complete the exact sentence from "The Robot Revolution Has Arrived".</p>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-500 block">Cloze Item</span>
            <span class="text-lg font-black text-indigo-600" id="cloze-progress">1 / 65</span>
          </div>
        </div>

        <!-- Sentence Box -->
        <div class="bg-amber-50/60 p-6 rounded-2xl border border-amber-200/80 space-y-4">
          <div class="flex items-center justify-between text-xs">
            <span class="font-bold text-amber-800 uppercase tracking-wider"><i class="fa-solid fa-quote-left mr-1"></i> Article Excerpt</span>
            <span class="bg-white px-2.5 py-1 rounded border border-amber-200 font-medium text-slate-600" id="cloze-cantonese-hint">廣東話提示: </span>
          </div>
          <p class="text-lg sm:text-xl font-serif text-slate-900 leading-relaxed" id="cloze-sentence-text">
            Loading cloze sentence...
          </p>
        </div>

        <!-- Word Choice Bank or Input -->
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 uppercase mb-2">Type or Select the Target Vocabulary Word:</label>
            <input type="text" id="cloze-input" placeholder="Type the missing vocabulary word..." class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 font-bold text-base text-slate-800">
          </div>

          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
            <span class="text-[11px] font-bold text-slate-500 uppercase block mb-2">Word Bank Helper (Click to autofill):</span>
            <div class="flex flex-wrap gap-2" id="cloze-word-bank">
              <!-- Helper word tags -->
            </div>
          </div>
        </div>

        <div id="cloze-feedback" class="hidden p-4 rounded-xl text-sm font-semibold"></div>

        <div class="flex justify-between items-center pt-2">
          <button onclick="revealClozeHint()" class="text-xs text-amber-700 hover:text-amber-900 font-bold underline flex items-center gap-1">
            <i class="fa-solid fa-lightbulb text-amber-500"></i> Show Definition Hint
          </button>
          <div class="flex space-x-2">
            <button onclick="checkClozeAnswer()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow transition">
              Verify Answer
            </button>
            <button onclick="nextClozeQuestion()" class="bg-cambridge-600 hover:bg-cambridge-700 text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow transition flex items-center gap-1.5">
              Next Sentence <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
        </div>
      </div>
    </section>

  </main>

  <script>
    /* Complete Database of all 65 Vocabulary Items with Cambridge Dictionary Definitions & Cantonese Translations */
    const vocabData = [
      {
        id: 1,
        word: "coined",
