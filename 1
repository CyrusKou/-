      matchScore = 0;
      document.getElementById('match-score').innerText = matchScore;
      document.getElementById('match-completion-msg').classList.add('hidden');
      
      // Pick 6 random vocabulary words
      const shuffled = [...vocabData].sort(() => 0.5 - Math.random());
      matchBatch = shuffled.slice(0, 6);

      const wordsCol = document.getElementById('match-col-words');
      const defsCol = document.getElementById('match-col-defs');

      wordsCol.innerHTML = '';
      defsCol.innerHTML = '';

      selectedWordCard = null;
      selectedDefCard = null;

      // Render Words (Left)
      matchBatch.forEach(item => {
        const btn = document.createElement('button');
        btn.dataset.id = item.id;
        btn.className = 'match-word-btn w-full p-4 rounded-xl border border-slate-200 bg-white hover:bg-cambridge-50 font-bold text-slate-800 text-sm shadow-sm transition text-left flex items-center justify-between';
        btn.onclick = () => selectMatchWord(btn, item.id);
        btn.innerHTML = `<span>${item.word}</span> <i class="fa-solid fa-chevron-right text-xs text-slate-300"></i>`;
        wordsCol.appendChild(btn);
      });

      // Render Meanings + Cantonese (Right Shuffled)
      const shuffledDefs = [...matchBatch].sort(() => 0.5 - Math.random());
      shuffledDefs.forEach(item => {
        const btn = document.createElement('button');
        btn.dataset.id = item.id;
        btn.className = 'match-def-btn w-full p-4 rounded-xl border border-slate-200 bg-white hover:bg-cantonese-50 text-left shadow-sm transition space-y-1';
        btn.onclick = () => selectMatchDef(btn, item.id);
        btn.innerHTML = `
          <div class="text-xs font-bold text-cantonese-600">${item.cantonese}</div>
          <div class="text-xs text-slate-600 leading-snug">${item.meaning}</div>
        `;
        defsCol.appendChild(btn);
      });
    }

    function selectMatchWord(btn, id) {
      if(btn.disabled) return;
      document.querySelectorAll('.match-word-btn').forEach(b => b.classList.remove('ring-2', 'ring-cambridge-500', 'bg-cambridge-100'));
      btn.classList.add('ring-2', 'ring-cambridge-500', 'bg-cambridge-100');
      selectedWordCard = { btn, id };
      checkMatchPair();
    }

    function selectMatchDef(btn, id) {
      if(btn.disabled) return;
      document.querySelectorAll('.match-def-btn').forEach(b => b.classList.remove('ring-2', 'ring-cantonese-500', 'bg-cantonese-100'));
      btn.classList.add('ring-2', 'ring-cantonese-500', 'bg-cantonese-100');
      selectedDefCard = { btn, id };
      checkMatchPair();
    }

    function checkMatchPair() {
      if(selectedWordCard && selectedDefCard) {
        if(selectedWordCard.id === selectedDefCard.id) {
          // Correct Match
          selectedWordCard.btn.className = 'w-full p-4 rounded-xl border border-emerald-300 bg-emerald-100 text-emerald-800 font-bold text-xs opacity-60 cursor-default text-left';
          selectedDefCard.btn.className = 'w-full p-4 rounded-xl border border-emerald-300 bg-emerald-100 text-emerald-800 text-xs opacity-60 cursor-default text-left';
          selectedWordCard.btn.disabled = true;
          selectedDefCard.btn.disabled = true;
          
          matchScore += 10;
          document.getElementById('match-score').innerText = matchScore;

          selectedWordCard = null;
          selectedDefCard = null;

          // Check if all matched
          const remaining = document.querySelectorAll('.match-word-btn:not([disabled])');
          if(remaining.length === 0) {
            document.getElementById('match-completion-msg').classList.remove('hidden');
          }
        } else {
          // Incorrect Match
          const wBtn = selectedWordCard.btn;
          const dBtn = selectedDefCard.btn;

          wBtn.classList.add('bg-red-100', 'border-red-300');
          dBtn.classList.add('bg-red-100', 'border-red-300');

          setTimeout(() => {
            wBtn.classList.remove('ring-2', 'ring-cambridge-500', 'bg-cambridge-100', 'bg-red-100', 'border-red-300');
            dBtn.classList.remove('ring-2', 'ring-cantonese-500', 'bg-cantonese-100', 'bg-red-100', 'border-red-300');
            selectedWordCard = null;
            selectedDefCard = null;
          }, 600);
        }
      }
    }

    /* MODULE 3: MULTIPLE CHOICE QUIZ */
    function initMcqModule() {
      mcqIndex = 0;
      mcqScore = 0;
      mcqList = [...vocabData].sort(() => 0.5 - Math.random());
      loadMcqQuestion();
    }

    function loadMcqQuestion() {
      if(mcqIndex >= mcqList.length) {
        mcqIndex = 0; // restart cycle
      }

      const item = mcqList[mcqIndex];
      document.getElementById('mcq-progress').innerText = `${mcqIndex + 1} / ${mcqList.length}`;
      document.getElementById('mcq-score-display').innerText = mcqScore;

      // Question: Give definition + Cantonese, ask for correct term
      document.getElementById('mcq-question-text').innerHTML = `
        <span class="text-cantonese-600 block text-base font-extrabold mb-1">粵語: ${item.cantonese}</span>
        <span class="text-slate-700 text-sm font-medium">Cambridge: "${item.meaning}"</span>
      `;

      // Generate 4 options (1 correct, 3 wrong)
      const distractors = vocabData.filter(v => v.id !== item.id).sort(() => 0.5 - Math.random()).slice(0, 3);
      const options = [...distractors, item].sort(() => 0.5 - Math.random());

      const container = document.getElementById('mcq-options-container');
      container.innerHTML = '';
      document.getElementById('mcq-feedback').className = 'hidden p-4 rounded-xl text-sm font-semibold';

      options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'mcq-opt-btn w-full p-4 rounded-xl border border-slate-200 bg-white hover:bg-cambridge-50 hover:border-cambridge-300 font-bold text-slate-800 text-left shadow-sm transition text-sm flex items-center justify-between';
        btn.onclick = () => answerMcq(btn, opt.id === item.id, item.word);
        btn.innerHTML = `<span>${opt.word}</span> <span class="text-xs text-slate-400 font-mono">${opt.pos}</span>`;
        container.appendChild(btn);
      });
    }

    function answerMcq(btn, isCorrect, correctWord) {
      document.querySelectorAll('.mcq-opt-btn').forEach(b => b.disabled = true);
      const feedback = document.getElementById('mcq-feedback');

      if(isCorrect) {
        btn.className = 'w-full p-4 rounded-xl border border-emerald-400 bg-emerald-100 text-emerald-900 font-bold text-left shadow-sm text-sm';
        feedback.className = 'p-4 rounded-xl text-sm font-bold bg-emerald-50 text-emerald-800 border border-emerald-200';
        feedback.innerHTML = `✅ Excellent! Correct answer: <strong>${correctWord}</strong>`;
        mcqScore += 10;
        document.getElementById('mcq-score-display').innerText = mcqScore;
      } else {
        btn.className = 'w-full p-4 rounded-xl border border-red-400 bg-red-100 text-red-900 font-bold text-left shadow-sm text-sm';
        feedback.className = 'p-4 rounded-xl text-sm font-bold bg-red-50 text-red-800 border border-red-200';
        feedback.innerHTML = `❌ Not quite! The correct term is: <strong>${correctWord}</strong>`;
      }
      feedback.classList.remove('hidden');
    }

    function nextMcqQuestion() {
      mcqIndex++;
      loadMcqQuestion();
    }

    /* MODULE 4: FILL IN THE BLANKS (CLOZE) */
    function initClozeModule() {
      clozeIndex = 0;
      clozeList = [...vocabData].sort(() => 0.5 - Math.random());
      loadClozeQuestion();
    }

    function loadClozeQuestion() {
      if(clozeIndex >= clozeList.length) clozeIndex = 0;

      const item = clozeList[clozeIndex];
      document.getElementById('cloze-progress').innerText = `${clozeIndex + 1} / ${clozeList.length}`;
      document.getElementById('cloze-cantonese-hint').innerText = `廣東話提示: ${item.cantonese}`;
      document.getElementById('cloze-input').value = '';
      document.getElementById('cloze-feedback').className = 'hidden p-4 rounded-xl text-sm font-semibold';

      // Create sentence with blank
      const regex = new RegExp(`\\b${item.word}\\b`, 'gi');
      const blankSentence = item.sentence.replace(regex, '______');
      document.getElementById('cloze-sentence-text').innerText = blankSentence;

      // Word Bank options
      const distractors = vocabData.filter(v => v.id !== item.id).sort(() => 0.5 - Math.random()).slice(0, 4);
      const bank = [...distractors, item].sort(() => 0.5 - Math.random());

      const bankContainer = document.getElementById('cloze-word-bank');
      bankContainer.innerHTML = '';
      bank.forEach(b => {
        const tag = document.createElement('button');
        tag.className = 'px-3 py-1 bg-white hover:bg-indigo-50 text-indigo-700 border border-slate-200 hover:border-indigo-300 rounded-lg text-xs font-bold shadow-sm transition';
        tag.onclick = () => {
          document.getElementById('cloze-input').value = b.word;
        };
        tag.innerText = b.word;
        bankContainer.appendChild(tag);
      });
    }

    function revealClozeHint() {
      const item = clozeList[clozeIndex];
      alert(`Cambridge English Definition:\n\n"${item.meaning}"`);
    }

    function checkClozeAnswer() {
      const item = clozeList[clozeIndex];
      const userInput = document.getElementById('cloze-input').value.trim().toLowerCase();
      const feedback = document.getElementById('cloze-feedback');

      if(userInput === item.word.toLowerCase()) {
        feedback.className = 'p-4 rounded-xl text-sm font-bold bg-emerald-50 text-emerald-800 border border-emerald-200';
        feedback.innerHTML = `🎉 Correct! "<strong>${item.word}</strong>" fits the passage sentence perfectly.`;
      } else {
        feedback.className = 'p-4 rounded-xl text-sm font-bold bg-red-50 text-red-800 border border-red-200';
        feedback.innerHTML = `❌ Not matching! The missing term is "<strong>${item.word}</strong>".`;
      }
      feedback.classList.remove('hidden');
    }

    function nextClozeQuestion() {
      clozeIndex++;
      loadClozeQuestion();
    }
  </script>

</body>
